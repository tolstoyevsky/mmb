# Passwords: never let a failing breach check break password create/share.
#
# The breach check (default provider HIBP -> api.pwnedpasswords.com) runs
# synchronously when a new revision is stored, including the recipient copy
# created during share synchronisation. If that external call fails, the
# exception aborts the revision save: password creation errors out and, for
# shares, the copy is never created so the share stays "updatePending" forever
# (endless spinner on the recipient). Make the check non-fatal: on failure the
# revision is stored as NOT_CHECKED and CheckPasswordsJob re-evaluates it later.
#
# Written against Passwords 2025.10.0 (bump PASSWORDS_VER -> re-check this patch).
# Reported upstream; drop once fixed there.
--- a/lib/EventListener/Password/AbstractPasswordListener.php
+++ b/lib/EventListener/Password/AbstractPasswordListener.php
@@ -55,7 +55,15 @@
      * @throws Exception
      */
     protected function checkSecurityStatus(PasswordRevision $revision, bool $searchDuplicates = true): void {
-        [$status, $statusCode] = $this->passwordSecurityCheckService->getRevisionSecurityLevel($revision);
+        try {
+            [$status, $statusCode] = $this->passwordSecurityCheckService->getRevisionSecurityLevel($revision);
+        } catch(\Throwable $e) {
+            // A failing breach check (e.g. the HIBP service is unreachable) must never abort
+            // saving or sharing a password. Leave it unchecked; CheckPasswordsJob re-evaluates later.
+            $revision->setStatus(PasswordSecurityCheckService::LEVEL_UNKNOWN);
+            $revision->setStatusCode(PasswordSecurityCheckService::STATUS_NOT_CHECKED);
+            return;
+        }
         $revision->setStatus($status);
         $revision->setStatusCode($statusCode);
